<mujoco model="Visual servoing - six joint teaching arm">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048" offsamples="4"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6"/>
    <map znear="0.01" zfar="20"/>
  </visual>
  <statistic center="0.55 0 0.35" extent="1.6"/>
  <default>
    <joint damping="0.8" armature="0.015" limited="true"/>
    <geom friction="0.7 0.01 0.001" condim="3"/>
    <default class="arm">
      <!-- Physical contacts are enabled; adjacent welded/jointed parts use MuJoCo filtering. -->
      <geom type="capsule" size="0.035" rgba="0.13 0.62 0.67 1"
            contype="1" conaffinity="1" density="800"/>
    </default>
    <default class="joint_shell">
      <geom type="sphere" size="0.046" rgba="0.13 0.18 0.23 1"
            contype="1" conaffinity="1"/>
    </default>
  </default>
  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.19 0.23 0.28" rgb2="0.24 0.28 0.33"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="10 10" reflectance="0.08"/>
    <texture name="marker_tex" type="2d" file="assets/marker.png"/>
    <texture name="natural_tex" type="2d" file="assets/natural-board.png"/>
    <material name="natural_mat" texture="natural_tex" texuniform="false"
              rgba="1 1 1 1" specular="0" shininess="0"/>
    <material name="marker_mat" texture="marker_tex" texuniform="false"
              rgba="1 1 1 1" specular="0" shininess="0"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor_mat"/>
    <geom name="base_plate" type="cylinder" pos="0 0 0.04" size="0.14 0.04"
          rgba="0.10 0.14 0.19 1"/>
    <geom name="pedestal" type="cylinder" pos="0 0 0.16" size="0.065 0.09"
          rgba="0.68 0.74 0.79 1"/>
    <!-- Optional mapped obstacle; enabled explicitly from the app or study. -->
    <body name="obstacle" mocap="true" pos="0.48 0.16 0.20">
      <geom name="obstacle_box" type="box" size="0.03 0.035 0.20"
            rgba="0.9 0.32 0.18 0" contype="0" conaffinity="0"/>
    </body>
    <body name="base_yaw" pos="0 0 0.30" gravcomp="1">
      <joint name="joint1" axis="0 0 1" range="-170 170"/>
      <geom name="base_shell" class="joint_shell"/>
      <body name="shoulder" gravcomp="1">
        <joint name="joint2" axis="0 1 0" range="-100 80"/>
        <geom name="upper_arm" class="arm" fromto="0 0 0 0.32 0 0"/>
        <body name="elbow" pos="0.32 0 0" gravcomp="1">
          <joint name="joint3" axis="0 1 0" range="-10 145"/>
          <geom name="elbow_shell" class="joint_shell"/>
          <geom name="forearm" class="arm" fromto="0 0 0 0.27 0 0"/>
          <body name="wrist_roll" pos="0.27 0 0" gravcomp="1">
            <joint name="joint4" axis="1 0 0" range="-170 170"/>
            <geom name="wrist_roll_shell" class="joint_shell" size="0.038"/>
            <geom name="wrist_roll_link" class="arm" fromto="0 0 0 0.10 0 0" size="0.026"/>
            <body name="wrist_pitch" pos="0.10 0 0" gravcomp="1">
              <joint name="joint5" axis="0 1 0" range="-100 100"/>
              <geom name="wrist_pitch_shell" class="joint_shell" size="0.033"/>
              <geom name="wrist_pitch_link" class="arm" fromto="0 0 0 0.06 0 0" size="0.022"/>
              <body name="tool_roll" pos="0.06 0 0" gravcomp="1">
                <joint name="joint6" axis="1 0 0" range="-170 170"/>
                <geom name="tool_link" class="arm" fromto="0 0 0 0.06 0 0" size="0.019"/>
                <body name="camera_mount" pos="0.07 0 0" gravcomp="1">
                  <geom name="camera_case" type="box" size="0.022 0.038 0.028"
                        rgba="0.10 0.13 0.18 1" contype="1" conaffinity="1" mass="0.08"/>
                  <geom name="lens" type="cylinder" size="0.015 0.007" pos="0.027 0 0"
                        euler="0 90 0" rgba="0.25 0.65 0.95 1" contype="1" conaffinity="1" mass="0.01"/>
                  <!-- MuJoCo camera looks along local -Z; +Y is image up.
                       Optical convention used in Python: +X right, +Y down, +Z forward. -->
                  <camera name="wrist" pos="0.04 0 0" xyaxes="0 -1 0 0 0 1" fovy="55"/>
                  <site name="camera_origin" pos="0.04 0 0" size="0.002" rgba="0 0 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="target" pos="1.16 0 0.27">
      <geom name="target_frame" type="box" size="0.016 0.185 0.185" rgba="0.85 0.62 0.26 1"/>
      <!-- Flat marker board, viewed from the -X side. -->
      <geom name="target_board" type="box" pos="-0.018 0 0" size="0.001 0.16 0.16"
            material="marker_mat"/>
      <geom name="target_stand" type="capsule" fromto="0.015 0 -0.27 0.015 0 -0.18"
            size="0.018" rgba="0.4 0.46 0.52 1"/>
      <geom name="target_foot" type="box" pos="0.015 0 -0.255" size="0.12 0.16 0.015"
            rgba="0.12 0.17 0.22 1"/>
    </body>
  </worldbody>
  <actuator>
    <velocity name="drive1" joint="joint1" kv="40" ctrlrange="-0.6 0.6" forcerange="-50 50"/>
    <velocity name="drive2" joint="joint2" kv="40" ctrlrange="-0.6 0.6" forcerange="-50 50"/>
    <velocity name="drive3" joint="joint3" kv="30" ctrlrange="-0.6 0.6" forcerange="-35 35"/>
    <velocity name="drive4" joint="joint4" kv="15" ctrlrange="-0.6 0.6" forcerange="-15 15"/>
    <velocity name="drive5" joint="joint5" kv="15" ctrlrange="-0.6 0.6" forcerange="-15 15"/>
    <velocity name="drive6" joint="joint6" kv="10" ctrlrange="-0.6 0.6" forcerange="-10 10"/>
  </actuator>
  <keyframe>
    <!-- Keyframe qpos is always radians. -->
    <key name="home" qpos="0 -0.6981317008 1.3962634016 0 -0.6981317008 0"/>
  </keyframe>
</mujoco>
