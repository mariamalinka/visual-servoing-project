<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Visual servoing diagnostics">
  <Profiles>
    <SystemCollector Id="NativeSystem" Name="Servo native scheduler">
      <BufferSize Value="1024"/><Buffers Value="768"/>
    </SystemCollector>
    <EventCollector Id="NativeEvents" Name="Servo GPU and power">
      <BufferSize Value="1024"/><Buffers Value="512"/>
    </EventCollector>
    <SystemProvider Id="NativeScheduler">
      <Keywords>
        <Keyword Value="CpuConfig"/><Keyword Value="ProcessThread"/><Keyword Value="Loader"/>
        <Keyword Value="SampledProfile"/><Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/><Keyword Value="ThreadPriority"/>
        <Keyword Value="DPC"/><Keyword Value="Interrupt"/><Keyword Value="HardFaults"/>
      </Keywords>
      <Stacks><Stack Value="SampledProfile"/><Stack Value="CSwitch"/><Stack Value="ReadyThread"/></Stacks>
    </SystemProvider>
    <!-- Include hardware scheduling events used by modern WDDM, omitted by the built-in GPU profile. -->
    <EventProvider Id="GpuScheduler" Name="Microsoft-Windows-DxgKrnl" Level="5" NonPagedMemory="true">
      <Keywords><Keyword Value="0x04000275"/></Keywords>
      <CaptureStateOnStart><Keyword Value="0x2490BFFF"/></CaptureStateOnStart>
      <CaptureStateOnSave><Keyword Value="0x0490BFFF"/></CaptureStateOnSave>
    </EventProvider>
    <EventProvider Id="CpuPower" Name="Microsoft-Windows-Kernel-Processor-Power" NonPagedMemory="true">
      <Keywords><Keyword Value="0x2ff"/></Keywords>
      <CaptureStateOnSave><Keyword Value="0xffffffff"/></CaptureStateOnSave>
    </EventProvider>
    <EventProvider Id="PowerPolicy" Name="Microsoft-Windows-Kernel-Power" NonPagedMemory="true">
      <Keywords><Keyword Value="0x100"/></Keywords>
      <CaptureStateOnSave><Keyword Value="0xffffffff"/></CaptureStateOnSave>
    </EventProvider>
    <Profile Id="ReuseNative.Verbose.Memory" Name="ReuseNative" Description="Bounded CPU waits and GPU scheduling; no system-call tracing" DetailLevel="Verbose" LoggingMode="Memory">
      <Collectors>
        <SystemCollectorId Value="NativeSystem"><SystemProviderId Value="NativeScheduler"/></SystemCollectorId>
        <EventCollectorId Value="NativeEvents"><EventProviders>
          <EventProviderId Value="GpuScheduler"/><EventProviderId Value="CpuPower"/><EventProviderId Value="PowerPolicy"/>
        </EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
